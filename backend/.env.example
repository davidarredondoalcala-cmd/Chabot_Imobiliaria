# ===== API de Brevo (Sendinblue) para envío automático de contratos y firmas =====
# Obtén tu API Key en https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notificaciones@habitatcapital.com
BREVO_SENDER_NAME="Habitat Capital Inmobiliaria"

# Fallback SMTP opcional (ej. relay de Brevo o Gmail)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ===== CONFIGURACIÓN DE IA (LLM) PARA JARVIS =====
# Jarvis soporta arquitectura multi-proveedor con failover automático.
# Si configuras Gemini y Groq, usará Gemini como motor principal y Groq como respaldo instantáneo si se agota la cuota.
# Si no configuras ninguna llave, Jarvis funciona en modo determinista local con reglas y plantillas.
#
# 1. Google Gemini (Motor Principal - https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# 2. Groq (Motor de Respaldo / Ultra Rápido - https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 3. Proveedor genérico opcional (OpenAI u OpenRouter)
# OPENAI_API_KEY=sk-proj-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
