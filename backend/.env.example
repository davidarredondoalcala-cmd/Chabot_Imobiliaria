# WhatsApp comercial para los enlaces del chatbot (código de país + número, sin + ni espacios)
WHATSAPP_NUMBER=573229001080

# ===== Login con Google (opcional: ya vienen embebidos en el código) =====
# Client ID de OAuth de Google (público). Si se omite, se usa el valor del código.
GOOGLE_CLIENT_ID=305367642614-imcnroh46epfbp8cmr3bbhqu230aa0jf.apps.googleusercontent.com
# Correos autorizados como administradores, separados por coma. Si se omite, se usa la lista del código.
ADMIN_EMAILS=macanabernal@gmail.com,montoyaherreracarlosmario@gmail.com,davidarredondoalcala@gmail.com,david.arredondo@estudiantesunibague.edu.co,juan.robayo1@estudiantesunibague.edu.co

# ===== API de Brevo (Sendinblue) para envío automático de contratos y firmas =====
# Obtén tu API Key en https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notificaciones@habitatcapital.com
BREVO_SENDER_NAME="Habitat Capital Inmobiliaria"

# Fallback SMTP opcional (ej. relay de Brevo o Gmail)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ===== CONFIGURACIÓN DE IA (LLM) PARA JARVIS (OPCIONAL) =====
# Si no configuras ninguna llave, Jarvis funciona en modo determinista local con reglas y plantillas.
# Si configuras una llave de IA, Jarvis activará generación natural, empatía y comprensión avanzada de intenciones:
#
# Opción A: OpenAI (Recomendado por precisión y naturalidad)
# OPENAI_API_KEY=sk-proj-...
# LLM_MODEL=gpt-4o-mini
#
# Opción B: Google Gemini (Gratuito en https://aistudio.google.com/)
# GEMINI_API_KEY=AIzaSy...
# LLM_MODEL=gemini-1.5-flash
#
# Opción C: Groq (Gratuito y ultra rápido en https://console.groq.com/)
# GROQ_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
#
# Opción D: OpenRouter o cualquier API compatible con OpenAI
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
