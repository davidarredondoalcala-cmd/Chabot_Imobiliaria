{
  "name": "inmobiliaria-chatbot-backend",
  "version": "1.0.0",
  "description": "Backend API y agente conversacional para inmobiliaria en Ibagué",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "tsx src/db/init.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:embeddings": "tsx src/db/generate_embeddings.ts",
    "db:setup": "tsx src/db/setup.ts",
    "eval": "tsx ../eval/evaluate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "openai": "^4.56.0",
    "pg": "^8.12.0",
    "pgvector": "^0.1.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.14",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
