# Configuración General del Servidor
PORT=3000
NODE_ENV=development

# Base de Datos PostgreSQL con pgvector
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inmobiliaria_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inmobiliaria_db
POSTGRES_PORT=5432

# Proveedor de LLM (openai | gemini | anthropic | ollama | mock)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=tu_api_key_aqui

# Embeddings (openai | gemini | ollama | mock)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# WhatsApp de Asesor Inmobiliario (número internacional con código de país, ej. 573001234567)
WHATSAPP_NUMBER=573100000000
